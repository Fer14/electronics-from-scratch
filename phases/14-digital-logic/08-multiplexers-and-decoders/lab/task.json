        1,
        5
      ],
      "p": [
        6,
        1
      ],
      "q": [
        6,
        5
      ],
      "y": [
        9,
        3
      ]
    },
    "fixed": [
      {
        "type": "gate",
        "id": "G1",
        "op": "not",
        "inputs": [
